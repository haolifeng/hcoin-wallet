{
  "name": "hcoinwallet",
  "version": "1.0.0",
  "description": "HCoinWallet - 基于 Electron 的多链桌面钱包",
  "main": "dist-electron/main.js",
  "desktopName": "HCoinWallet",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "tsc && vite build",
    "icons": "node scripts/gen-icons.js",
    "electron:dev": "node scripts/dev.js",
    "electron:build": "npm run dist",
    "electron:install": "node scripts/install-electron.js",
    "dist": "npm run icons && npm run build && electron-builder",
    "dist:dir": "npm run icons && npm run build && electron-builder --dir",
    "dist:win": "npm run icons && npm run build && electron-builder --win",
    "dist:mac": "npm run icons && npm run build && electron-builder --mac",
    "dist:linux": "npm run icons && npm run build && electron-builder --linux",
    "dist:all": "npm run icons && npm run build && electron-builder --win --mac --linux",
    "postinstall": "node scripts/install-electron.js"
  },
  "keywords": [],
  "author": {
    "name": "HCoinWallet"
  },
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=9"
  },
  "build": {
    "appId": "com.hcoin.wallet",
    "productName": "HCoinWallet",
    "copyright": "Copyright © 2026 HCoinWallet",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/prebuilds/**"
    ],
    "npmRebuild": false,
    "compression": "maximum",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "release/${version}",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HCoinWallet",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "${productName} ${version}",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Finance",
      "maintainer": "HCoinWallet",
      "synopsis": "HCoinWallet - 多链桌面钱包",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@scure/bip32": "^2.4.0",
    "@scure/btc-signer": "^2.4.1",
    "@solana/web3.js": "^1.99.0",
    "antd": "^5.21.0",
    "bip39": "^3.1.2",
    "classic-level": "^3.0.0",
    "ethers": "^6.17.0",
    "mobx": "^6.13.0",
    "mobx-react-lite": "^4.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^41.10.6",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0"
  }
}
